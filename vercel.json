{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/*.ts": {
      "maxDuration": 30
    }
  },
  "redirects": [
    {
      "source": "/podcast",
      "destination": "/?utm_source=youtube&utm_medium=podcast&utm_campaign=narikbi_live&utm_content=4UpMCaYnnLw",
      "permanent": false
    },
    {
      "source": "/podcast/:name/:episode",
      "destination": "/?utm_source=youtube&utm_medium=podcast&utm_campaign=:name&utm_content=:episode",
      "permanent": false
    },
    {
      "source": "/podcast/:name",
      "destination": "/?utm_source=youtube&utm_medium=podcast&utm_campaign=:name",
      "permanent": false
    },
    {
      "source": "/t/:code",
      "destination": "/?t=:code",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/admin/", "destination": "/admin.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/privacy/", "destination": "/privacy.html" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    },
    {
      "source": "/admin.html",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ]
}
