# ──────────────────────────────────────────────────────────────
# braverman.kz — переменные окружения
# Локально: скопируй в .env. В проде: Vercel → Settings → Environment Variables.
# Без DATABASE_URL тест работает, но ничего не сохраняется и оплата невозможна.
# ──────────────────────────────────────────────────────────────

# ── База (Neon Postgres, проект «braverman») ──
DATABASE_URL=

# ── Секреты токенов (openssl rand -base64 32 — каждый свой, НЕ из MindQuiz) ──
# ACCESS_SECRET — подпись токенов попытки/результата и кода WhatsApp
# ADMIN_SECRET  — подпись сессий админки и кабинета тренера, хеш IP
ACCESS_SECRET=
ADMIN_SECRET=

# ── Вход в админку ──
ADMIN_LOGIN=
ADMIN_PASSWORD=

# ── Kaspi-шлюз braverman-kaspi (Fly.io) ──
# KASPI_GW_TOKEN = GATEWAY_TOKEN шлюза, KASPI_GW_WEBHOOK_SECRET = WEBHOOK_SECRET шлюза.
# Вебхук шлюза (WEBHOOK_URL на Fly): https://braverman.kz/api/kaspi-gw-webhook
KASPI_GW_URL=https://braverman-kaspi.fly.dev
KASPI_GW_TOKEN=
KASPI_GW_WEBHOOK_SECRET=

# ── Оффер ──
PRICE_KZT=5000
INVOICE_DESCRIPTION=Тест Бравермана — нейропрофиль
SITE_URL=https://braverman.kz

# ── Тестирование ──
# ?test=<TEST_TOKEN> в адресе сайта → счёт на TEST_AMOUNT ₸ вместо полной цены
TEST_TOKEN=
TEST_AMOUNT=1
# 1 = демо без оплаты: результат открывается сразу после ввода номера (только для разработки!)
SIMULATE_PAYMENT=0

# ── Telegram: уведомления владельцу (опционально) ──
TG_BOT_TOKEN=
TG_CHAT_ID=

# ── WhatsApp через общий шлюз mindquiz-wa (опционально): ссылка на результат + код восстановления ──
WA_API_URL=https://mindquiz-wa.fly.dev
WA_TOKEN=

# ── Кабинет тренера ──
# 1 = тренер видит телефоны своих клиентов, 0 = телефон маскируется
TRAINER_SEES_PHONE=1

# ── Google-таблица (опциональное зеркало, Apps Script /exec; основной источник — админка) ──
SHEET_ENDPOINT=

# ── Фронтенд (попадают в бандл — только публичные значения) ──
# Цена на экране оплаты (должна совпадать с PRICE_KZT)
VITE_PRICE_KZT=5000
VITE_META_PIXEL_ID=
VITE_TIKTOK_PIXEL_ID=
VITE_VIDEO_BASE=https://pub-5a014c13711042d6b1b4e8d96d558550.r2.dev
